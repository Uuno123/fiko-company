# Kopioi tämä tiedosto nimelle ".env" jos backend ei pyöri oletusportissa 4000.
VITE_API_URL=http://localhost:4000

# Supabase-projektin tiedot (Project Settings -> API). Tarvitaan asiakkaan
# kirjautumista/rekisteröitymistä varten (frontend käyttää Supabase Authia suoraan).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Stripen julkinen (publishable) avain - turvallinen frontendissä, Stripe Elements käyttää tätä.
VITE_STRIPE_PUBLISHABLE_KEY=

# Google Maps Platform -avain. Maps Demo Key (ei maksukorttia, 100 kutsua/pv per API)
# riittää esittelyyn; tuotantoon tavallinen avain + laskutustili.
VITE_GOOGLE_MAPS_API_KEY=
