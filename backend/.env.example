# Kopioi tämä tiedosto nimelle ".env" ja täytä arvot Supabase-projektistasi
# (Project Settings -> API). Ilman näitä backend toimii silti paikallisella
# esimerkkidatalla (ks. src/data/seedRestaurants.js).
SUPABASE_URL=
SUPABASE_ANON_KEY=

PORT=4000
FRONTEND_URL=http://localhost:5173

# Stripe-testiavain (Dashboard -> Developers -> API keys). Salainen avain - ei koskaan frontendiin.
STRIPE_SECRET_KEY=

# Supabase service_role -avain (Project Settings -> API -> service_role). Tarvitaan
# veloituksiin (src/settlement.js): kortin varaus veloitetaan, kun ravintola hyväksyy
# tilauksen, ja vapautetaan, jos tilaus peruuntuu. Ohittaa RLS:n - vain tähän
# tiedostoon, ei koskaan frontendiin, kuljettaja-appiin tai gitiin.
SUPABASE_SERVICE_ROLE_KEY=
