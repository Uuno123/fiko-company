{
  "expo": {
    "name": "Bidrop kuljettaja",
    "slug": "delivo-kuljettaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fi.delivo.kuljettaja"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "fi.delivo.kuljettaja",
      "googleServicesFile": "./google-services.json",
      "userInterfaceStyle": "light",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bidrop näyttää sijaintisi kartalla ja tarjoaa sinulle lähimpiä keikkoja."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bidrop tarvitsee kuvan dokumentista, jonka lähetät tarkastettavaksi (esim. henkilökortti tai ajokortti).",
          "cameraPermission": "Bidrop käyttää kameraa, kun kuvaat dokumentin tarkastettavaksi.",
          "microphonePermission": false
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#f4501e",
          "defaultChannel": "gigs"
        }
      ]
    ],
    "scheme": "delivo-kuljettaja",
    "backgroundColor": "#ffffff",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bd3b4b1-c95a-4e5c-bc13-c0009bd4c1b1"
      }
    },
    "owner": "uuno123",
    "updates": {
      "url": "https://u.expo.dev/2bd3b4b1-c95a-4e5c-bc13-c0009bd4c1b1"
    }
  }
}
