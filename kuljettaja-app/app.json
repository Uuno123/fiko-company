{
  "expo": {
    "name": "delivo kuljettaja",
    "slug": "delivo-kuljettaja",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "fi.delivo.kuljettaja"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "fi.delivo.kuljettaja",
      "userInterfaceStyle": "light"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "delivo näyttää sijaintisi kartalla ja tarjoaa sinulle lähimpiä keikkoja."
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "delivo tarvitsee kuvan dokumentista, jonka lähetät tarkastettavaksi (esim. henkilökortti tai ajokortti).",
          "cameraPermission": "delivo käyttää kameraa, kun kuvaat dokumentin tarkastettavaksi.",
          "microphonePermission": false
        }
      ],
      "expo-asset"
    ],
    "scheme": "delivo-kuljettaja",
    "backgroundColor": "#ffffff"
  }
}
